---
import Layout from '../layouts/Layout.astro'
import { TOOLS } from '../data/tools'
import { API_URL, SITE } from '../lib/config'

const specs = [
  { k: 'Endpoints', v: '04' },
  { k: 'Auth', v: 'NO' },
  { k: 'Rate limit', v: 'NO' },
  { k: 'Instalacion', v: 'NO' },
]

const sample = [
  { c: '# 5 usuarios ficticios en espanol', t: 'comment' },
  { c: `curl ${API_URL}/fake/user?count=5&locale=es`, t: 'cmd' },
  { c: '', t: 'blank' },
  { c: '# imagen 800x400 con fondo propio', t: 'comment' },
  { c: `curl ${API_URL}/img/800x400?bg=E61919&text=Banner`, t: 'cmd' },
  { c: '', t: 'blank' },
  { c: '# 3 parrafos de lorem en HTML', t: 'comment' },
  { c: `curl ${API_URL}/text?type=paragraphs&count=3&format=html`, t: 'cmd' },
]
---

<Layout title="Toolkit HTTP" unit="INDEX">
  <!-- ============ HERO ============ -->
  <section class="border-b border-line py-16 md:py-24">
    <p class="t-label mb-6 flex flex-wrap items-center gap-2">
      <span class="bg-accent px-1.5 py-0.5 text-accent-fg">API PUBLICA</span>
      <span class="text-fg-faint">///</span>
      <span>SIN AUTH</span>
      <span class="text-fg-faint">///</span>
      <span>SIN SETUP</span>
    </p>

    <h1 class="t-display t-h1">
      Herramientas<br />
      HTTP para<br />
      <span class="text-accent">devs que</span><br />
      van rapido
    </h1>

    <div class="mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="t-body max-w-[54ch]">
        Imagenes placeholder, lorem ipsum, datos ficticios y mock APIs.
        Todo servido desde una URL que puedes pegar en el navegador,
        en un <samp class="text-fg">curl</samp> o en tu <samp class="text-fg">fetch</samp>.
      </p>

      <div class="flex flex-wrap gap-2">
        <a href="/playground" class="btn btn-primary">
          Abrir playground
          <span aria-hidden="true">&gt;&gt;</span>
        </a>
        <a href={`${API_URL}/docs`} target="_blank" rel="noreferrer" class="btn btn-ghost">
          API Docs
        </a>
      </div>
    </div>
  </section>

  <!-- ============ FICHA TECNICA ============ -->
  <section class="grid-hairline mt-px grid-cols-2 border-x-0 md:grid-cols-4">
    {
      specs.map((s) => (
        <div class="px-5 py-6">
          <dt class="t-label">{s.k}</dt>
          <dd class="t-display mt-2 text-3xl">{s.v}</dd>
        </div>
      ))
    }
  </section>

  <!-- ============ UNIDADES ============ -->
  <section class="py-16 md:py-20">
    <header class="mb-8 flex items-baseline justify-between gap-4 border-b border-line pb-4">
      <h2 class="t-display t-h2">Unidades</h2>
      <span class="t-label">[ 04 DISPONIBLES ]</span>
    </header>

    <div class="grid-hairline md:grid-cols-2">
      {
        TOOLS.map((tool) => (
          <a href={`/playground#${tool.id}`} class="group relative block p-6 transition-colors hover:bg-surface md:p-8">
            <div class="mb-5 flex items-start justify-between gap-4">
              <span class="t-display text-5xl leading-none text-fg-faint transition-colors group-hover:text-accent">
                {tool.index}
              </span>
              <span class="t-label border border-line px-2 py-1 text-fg-muted">
                {tool.id}
              </span>
            </div>

            <h3 class="t-display t-h3 mb-2.5">{tool.name}</h3>
            <p class="t-body mb-6 max-w-[42ch]">
              {tool.description}
            </p>

            <dl class="space-y-1.5 border-t border-line pt-4">
              <div class="flex items-baseline justify-between gap-3">
                <dt class="t-label">Endpoint</dt>
                <dd class="text-right"><samp class="break-all text-[0.6875rem] text-fg">{tool.endpoint}</samp></dd>
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="t-label">Devuelve</dt>
                <dd><samp class="text-[0.6875rem] text-fg-muted">{tool.returns}</samp></dd>
              </div>
            </dl>

            <span
              class="t-meta absolute bottom-6 right-6 text-fg-faint transition-colors group-hover:text-accent md:bottom-8 md:right-8"
              aria-hidden="true"
            >
              &gt;&gt;
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ TERMINAL ============ -->
  <section class="border border-line">
    <header class="flex items-center justify-between gap-4 border-b border-line bg-surface px-4 py-2">
      <span class="t-label text-fg">/// ARRANQUE RAPIDO</span>
      <span class="t-label text-fg-muted">SH</span>
    </header>

    <div class="overflow-x-auto p-4 md:p-6">
      <pre class="text-[0.75rem] leading-6"><code>{
        sample.map((line, i) => (
          <span class="flex gap-4">
            <span class="w-5 shrink-0 select-none text-right text-fg-faint">{i + 1}</span>
            {line.t === 'comment' ? (
              <span class="text-fg-faint">{line.c}</span>
            ) : line.t === 'cmd' ? (
              <span class="whitespace-pre"><span class="text-accent">$ </span><span class="text-fg">{line.c}</span></span>
            ) : (
              <span>&nbsp;</span>
            )}
          </span>
        ))
      }</code></pre>
    </div>
  </section>

  <!-- ============ CIERRE ============ -->
  <section class="mt-16 border-t-2 border-line-hard pt-10">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
      <h2 class="t-display t-h2 max-w-[16ch]">
        Pruebalo sin<br />escribir una linea
      </h2>
      <a href="/playground" class="btn btn-primary justify-self-start">
        Ir al playground <span aria-hidden="true">&gt;&gt;</span>
      </a>
    </div>
    <p class="t-label mt-8 text-fg-faint">
      {SITE.unit}® / REV {SITE.rev} / BUILD ESTATICO / SIN DEPENDENCIAS EXTERNAS
    </p>
  </section>
</Layout>
