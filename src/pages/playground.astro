---
import Layout from '../layouts/Layout.astro'
import ApiTester from '../components/ApiTester.tsx'
import { TOOLS } from '../data/tools'
import { API_URL } from '../lib/config'
---

<Layout
  title="Playground"
  unit="PLAYGROUND"
  description="Ejecuta cada herramienta de DevKit desde el navegador y mira la respuesta en crudo."
>
  <!-- ============ ENCABEZADO ============ -->
  <section class="border-b border-line py-12 md:py-16">
    <p class="t-label mb-5 text-fg-faint">/// BANCO DE PRUEBAS</p>
    <h1 class="t-display t-h1">Playground</h1>
    <p class="t-body mt-6 max-w-[58ch]">
      Ajusta los parametros, dispara el request y mira la respuesta en crudo.
      La URL es copiable y funciona igual en tu terminal.
    </p>
  </section>

  <!-- ============ SELECTOR DE UNIDAD ============ -->
  <nav class="grid-hairline mt-8 grid-cols-2 md:grid-cols-4" id="tabs" aria-label="Herramientas">
    {
      TOOLS.map((tool) => (
        <button
          type="button"
          data-tab={tool.id}
          aria-selected="false"
          class="tab-btn flex items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-surface"
        >
          <span class="t-display text-xl leading-none text-fg-faint" data-tab-index>
            {tool.index}
          </span>
          <span class="t-meta" data-tab-label>{tool.id}</span>
        </button>
      ))
    }
  </nav>

  <!-- ============ IMG ============ -->
  <section id="panel-img" class="panel py-10">
    <header class="mb-6 border-b border-line pb-4">
      <h2 class="t-display t-h2">Imagen Placeholder</h2>
      <p class="t-body mt-2 max-w-[52ch]">
        Genera imagenes on-the-fly con las dimensiones, color y texto que necesites.
      </p>
    </header>

    <div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-5">
      <div>
        <label class="t-label mb-1.5 block" for="img-w">Width</label>
        <input data-control id="img-w" type="number" value="400" min="1" max="5000" class="field" />
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="img-h">Height</label>
        <input data-control id="img-h" type="number" value="300" min="1" max="5000" class="field" />
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="img-bg">Fondo (hex)</label>
        <input data-control id="img-bg" type="text" value="E61919" spellcheck="false" class="field" />
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="img-text">Texto</label>
        <input data-control id="img-text" type="text" value="" placeholder="opcional" class="field" />
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="img-fmt">Formato</label>
        <select data-control id="img-fmt" class="field">
          <option value="jpeg">jpeg</option>
          <option value="png">png</option>
          <option value="webp">webp</option>
        </select>
      </div>
    </div>

    <ApiTester id="tester-img" defaultUrl={`${API_URL}/img/400x300?bg=E61919&format=jpeg`} client:load />
  </section>

  <!-- ============ TEXT ============ -->
  <section id="panel-text" class="panel hidden py-10">
    <header class="mb-6 border-b border-line pb-4">
      <h2 class="t-display t-h2">Generador de Texto</h2>
      <p class="t-body mt-2 max-w-[52ch]">
        Lorem ipsum en el formato y la cantidad exacta que pidas.
      </p>
    </header>

    <div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-3">
      <div>
        <label class="t-label mb-1.5 block" for="text-type">Tipo</label>
        <select data-control id="text-type" class="field">
          <option value="sentences">sentences</option>
          <option value="words">words</option>
          <option value="paragraphs">paragraphs</option>
        </select>
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="text-count">Cantidad</label>
        <input data-control id="text-count" type="number" value="5" min="1" max="100" class="field" />
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="text-fmt">Formato</label>
        <select data-control id="text-fmt" class="field">
          <option value="plain">plain</option>
          <option value="json">json</option>
          <option value="html">html</option>
        </select>
      </div>
    </div>

    <ApiTester id="tester-text" defaultUrl={`${API_URL}/text?type=sentences&count=5&format=json`} client:load />
  </section>

  <!-- ============ FAKE ============ -->
  <section id="panel-fake" class="panel hidden py-10">
    <header class="mb-6 border-b border-line pb-4">
      <h2 class="t-display t-h2">Datos Ficticios</h2>
      <p class="t-body mt-2 max-w-[52ch]">
        Objetos JSON coherentes por schema, con locale y seed reproducible.
      </p>
    </header>

    <div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
      <div>
        <label class="t-label mb-1.5 block" for="fake-schema">Schema</label>
        <select data-control id="fake-schema" class="field">
          <option value="user">user</option>
          <option value="product">product</option>
          <option value="post">post</option>
          <option value="company">company</option>
        </select>
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="fake-count">Cantidad</label>
        <input data-control id="fake-count" type="number" value="3" min="1" max="100" class="field" />
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="fake-locale">Locale</label>
        <select data-control id="fake-locale" class="field">
          <option value="en">en</option>
          <option value="es">es</option>
        </select>
      </div>
      <div>
        <label class="t-label mb-1.5 block" for="fake-seed">Seed</label>
        <input data-control id="fake-seed" type="text" value="" placeholder="opcional" class="field" />
      </div>
    </div>

    <ApiTester id="tester-fake" defaultUrl={`${API_URL}/fake/user?count=3&locale=en`} client:load />
  </section>

  <!-- ============ MOCK ============ -->
  <section id="panel-mock" class="panel hidden py-10">
    <header class="mb-6 border-b border-line pb-4">
      <h2 class="t-display t-h2">Mock API REST</h2>
      <p class="t-body mt-2 max-w-[54ch]">
        Crea un proyecto, registra endpoints y consumelos como una API real.
        Los tres pasos van en orden.
      </p>
    </header>

    <ol class="space-y-4">
      <li class="border border-line">
        <p class="t-label border-b border-line bg-surface px-3 py-2">
          Paso 01 <span class="text-fg-muted">///</span> Crear proyecto
        </p>
        <div class="p-3 md:p-4">
          <ApiTester id="tester-mock-create" defaultUrl={`${API_URL}/mock/create`} method="POST" client:load />
        </div>
      </li>

      <li class="border border-line">
        <p class="t-label border-b border-line bg-surface px-3 py-2">
          Paso 02 <span class="text-fg-muted">///</span> Registrar endpoint
        </p>
        <div class="p-3 md:p-4">
          <p class="t-body mb-3 text-fg-faint">
            Pega el projectId del paso anterior en la URL.
          </p>
          <ApiTester
            id="tester-mock-register"
            defaultUrl={`${API_URL}/mock/{projectId}/register`}
            method="POST"
            body={{
              path: '/users',
              method: 'GET',
              status: 200,
              response: { users: [{ id: 1, name: 'Luis' }] },
              delay: 0,
              headers: {},
            }}
            client:load
          />
        </div>
      </li>

      <li class="border border-line">
        <p class="t-label border-b border-line bg-surface px-3 py-2">
          Paso 03 <span class="text-fg-muted">///</span> Consumir endpoint
        </p>
        <div class="p-3 md:p-4">
          <ApiTester id="tester-mock-run" defaultUrl={`${API_URL}/run/{projectId}/users`} client:load />
        </div>
      </li>
    </ol>
  </section>
</Layout>

<script>
  import { API_URL } from '../lib/config'

  const TABS = ['img', 'text', 'fake', 'mock'] as const
  type TabId = (typeof TABS)[number]

  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'))
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'))

  function activate(tab: TabId) {
    for (const btn of tabButtons) {
      const active = btn.dataset.tab === tab
      btn.setAttribute('aria-selected', String(active))
      btn.classList.toggle('bg-fg', active)
      btn.classList.toggle('text-bg', active)
      btn.querySelector('[data-tab-index]')?.classList.toggle('text-accent', active)
      btn.querySelector('[data-tab-index]')?.classList.toggle('text-fg-faint', !active)
    }
    for (const panel of panels) {
      panel.classList.toggle('hidden', panel.id !== `panel-${tab}`)
    }
  }

  for (const btn of tabButtons) {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab as TabId
      activate(tab)
      history.replaceState(null, '', `#${tab}`)
    })
  }

  function fromHash(): TabId {
    const hash = window.location.hash.replace('#', '') as TabId
    return TABS.includes(hash) ? hash : 'img'
  }

  activate(fromHash())
  window.addEventListener('hashchange', () => activate(fromHash()))

  /* ---- Sincronizacion de parametros -> URL del tester ----
     La isla de React es duena de su estado, asi que no le escribimos el
     input: le mandamos un evento y ella decide. */

  function value(id: string): string {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null
    return el?.value.trim() ?? ''
  }

  function withOptional(base: string, params: Record<string, string>): string {
    const search = new URLSearchParams()
    for (const [key, val] of Object.entries(params)) {
      if (val !== '') search.set(key, val)
    }
    const query = search.toString()
    return query ? `${base}?${query}` : base
  }

  const builders: Record<string, () => string> = {
    img: () =>
      withOptional(`${API_URL}/img/${value('img-w') || 1}x${value('img-h') || 1}`, {
        bg: value('img-bg'),
        text: value('img-text'),
        format: value('img-fmt'),
      }),
    text: () =>
      withOptional(`${API_URL}/text`, {
        type: value('text-type'),
        count: value('text-count'),
        format: value('text-fmt'),
      }),
    fake: () =>
      withOptional(`${API_URL}/fake/${value('fake-schema') || 'user'}`, {
        count: value('fake-count'),
        locale: value('fake-locale'),
        seed: value('fake-seed'),
      }),
  }

  for (const [tool, build] of Object.entries(builders)) {
    const panel = document.getElementById(`panel-${tool}`)
    for (const control of panel?.querySelectorAll('[data-control]') ?? []) {
      control.addEventListener('input', () => {
        window.dispatchEvent(
          new CustomEvent('devkit:url', {
            detail: { id: `tester-${tool}`, url: build() },
          }),
        )
      })
    }
  }
</script>
